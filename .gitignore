# 后端构建产物
target/
*.jar
!**/.mvn/wrapper/*.jar
*.war
*.class
*.log

# 前端依赖与构建产物
node_modules/
dist/
dist-ssr/
.vite/
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# 工作区内的 Maven 本地仓库（构建时自动生成，不应提交）
.m2repo/

# IDE
.idea/
*.iml
.vscode/
.settings/

# 操作系统
Thumbs.db
.DS_Store

# 本机数据库口令等本地配置覆盖
**/application-local.yml
**/application-local.properties

# ---------------- 以下内容仅保留在本地，不纳入代码仓库 ----------------
# 作业与实验文档、报告生成脚本、设计图、测试与排版工具
/docs/
/tests/
/tools/
/*.docx
/README.md
# 数据库自检脚本的输出
/db/verify_output.txt
